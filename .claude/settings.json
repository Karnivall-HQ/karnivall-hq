{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "WebSearch", "WebFetch",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(grep:*)", "Bash(find:*)",
      "Bash(mkdir:*)", "Bash(date:*)", "Bash(wc:*)", "Bash(jq:*)", "Bash(python3:*)", "Bash(node:*)", "Bash(npm:*)", "Bash(npx:*)",
      "Bash(git:*)", "Bash(curl:*)", "Bash(sed:*)", "Bash(sort:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(touch:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)", "Bash(rm -rf ~*)", "Bash(sudo:*)",
      "Edit(.claude/settings.json)", "Write(.claude/settings.json)",
      "Edit(fuku/bin/heartbeat.sh)", "Write(fuku/bin/heartbeat.sh)"
    ]
  }
}
